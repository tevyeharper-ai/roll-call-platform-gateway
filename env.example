PORT=8080
NODE_ENV=production
RC_GATEWAY_ENV=staging
RC_GATEWAY_SERVICE_ID=roll-call-platform-gateway:p3.6-staging
RC_REFERENCE_CONSUMERS=events,broadcast,field,experiential,asmbly
RC_GATEWAY_PRIVATE_KEY_PEM=
RC_GATEWAY_PUBLIC_KEY_PEM=
RC_WORDPRESS_ORIGIN=

# Shared Platform Access / Roll Call Core
RC_PLATFORM_ACCESS_URL=
RC_PLATFORM_ACCESS_GATEWAY_KEY=

# P3.3 OMNI read broker compatibility
RC_OMNI_GATEWAY_SERVICE_KEY_SHA256=
RC_ROLL_CALL_EVENTS_READ_URL=
RC_ROLL_CALL_EVENTS_READ_KEY=
# JSON map: {"organization_id:workspace_id":{"tenant_id":"...","workspace_id":"..."}}
RC_EVENTS_WORKSPACE_BINDINGS_JSON={}

# Roll Call Broadcast owner service
RC_ROLL_CALL_BROADCAST_URL=
RC_ROLL_CALL_BROADCAST_SERVICE_KEY=
RC_OMNI_ROLL_CALL_ORGANIZATION_ID=roll-call-events
RC_OMNI_ROLL_CALL_TENANT_ID=
RC_OMNI_ROLL_CALL_WORKSPACE_ID=
RC_ACCESS_RECEIPT_MAX_AGE_SECONDS=120

# Shared Roll Call browser session / BSV Identity OIDC
RC_OIDC_ISSUER=
RC_OIDC_CLIENT_ID=roll-call-staging
RC_OIDC_CLIENT_SECRET=
RC_PUBLIC_URL=
RC_SESSION_SECRET=

# P3.6 same-origin toolkit routing.
# Broadcast must be built with ROLL_CALL_BASE_PATH=/app/broadcast.
# Gateway enforces the shared browser session and roll-call.broadcast entitlement
# before forwarding /app/broadcast/* to RC_ROLL_CALL_BROADCAST_URL.
